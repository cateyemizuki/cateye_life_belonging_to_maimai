{
  "schema_version": 2,
  "required_capabilities": [
    "custom_pages"
  ],
  "workspace_title": "属于麦麦的生活",
  "pages": [
    {
      "id": "overview",
      "mode": "custom",
      "title": "属于麦麦的生活",
      "icon": "chart",
      "placement": "sidebar",
      "entry": "webui/index.html",
      "layout": "viewport",
      "queries": {
        "summary": {
          "api": "life_dashboard",
          "version": "1",
          "parameters": {
            "hours": {
              "type": "integer",
              "minimum": 6,
              "maximum": 168,
              "choices": [
                6,
                24,
                72,
                168
              ]
            },
            "day": {
              "type": "string",
              "required": false,
              "max_length": 10
            },
            "usage_hours": {
              "type": "integer",
              "minimum": 24,
              "maximum": 720,
              "choices": [
                24,
                168,
                720
              ]
            },
            "usage_rows_limit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200,
              "required": false
            },
            "usage_rows_offset": {
              "type": "integer",
              "minimum": 0,
              "required": false
            }
          }
        }
      }
    }
  ]
}
