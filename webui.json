{
  "schema_version": 2,
  "required_capabilities": [
    "custom_pages"
  ],
  "workspace_title": "属于麦麦的生活",
  "pages": [
    {
      "id": "overview",
      "mode": "custom",
      "title": "属于麦麦的生活",
      "icon": "chart",
      "placement": "sidebar",
      "entry": "webui/index.html",
      "layout": "document",
      "queries": {
        "summary": {
          "api": "life_dashboard",
          "version": "1",
          "parameters": {
            "hours": {
              "type": "integer",
              "minimum": 6,
              "maximum": 168,
              "choices": [
                6,
                24,
                72,
                168
              ]
            },
            "day": {
              "type": "string",
              "required": false,
              "max_length": 10
            }
          }
        }
      }
    }
  ]
}
